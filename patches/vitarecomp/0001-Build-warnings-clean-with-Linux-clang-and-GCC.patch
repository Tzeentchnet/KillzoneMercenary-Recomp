index 0000000..62fae4e
--- /dev/null
+++ b/tests/test_nids.c
@@ -0,0 +1,87 @@
+/* test_nids.c — the NID database loader, on a synthetic database.
+ *
+ * The real database (vita-headers db/360) carries mangled C++ names up to 96
+ * bytes long. A name that does not fit the loader's buffer must come back
+ * unresolved rather than truncated: a truncated name becomes an HLE symbol
+ * that no implementation defines. No game data.
+ */
+
+#include "nids.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifdef NDEBUG
+#error "tests must be built with asserts enabled (NDEBUG is defined)"
+#endif
+
+#define LIB_NID 0x12345678u
+#define FN_96 0x00000096u
+#define FN_127 0x00000127u
+#define FN_128 0x00000128u
+#define VAR_127 0x10000127u
+
+static void make_name(char *dst, size_t length, char fill) {
+    dst[0] = '_';
+    memset(dst + 1, fill, length - 1);
+    dst[length] = '\0';
+}
+
+int main(int argc, char **argv) {
+    assert(argc == 2);
+    char path[1024];
+    int n = snprintf(path, sizeof(path), "%s/test.yml", argv[1]);
+    assert(n > 0 && (size_t)n < sizeof(path));
+
+    char name96[97], name127[128], name128[129], var127[128];
+    make_name(name96, 96, 'a');
+    make_name(name127, 127, 'b');
+    make_name(name128, 128, 'c');
+    make_name(var127, 127, 'v');
+
+    FILE *f = fopen(path, "w");
+    assert(f);
+    fprintf(f,
+            "version: 2\n"
+            "firmware: 3.60\n"
+            "modules:\n"
+            "  SceTest:\n"
+            "    nid: 0x00000001\n"
+            "    libraries:\n"
+            "      SceTestLib:\n"
+            "        kernel: false\n"
+            "        nid: 0x%08X\n"
+            "        functions:\n"
+            "          %s: 0x%08X\n"
+            "          %s: 0x%08X\n"
+            "          %s: 0x%08X\n"
+            "        variables:\n"
+            "          %s: 0x%08X\n",
+            LIB_NID, name96, FN_96, name127, FN_127, name128, FN_128, var127,
+            VAR_127);
+    fclose(f);
+
+    int files = 0, entries = 0;
+    nid_db *db = nid_db_load(argv[1], &files, &entries);
+    assert(db);
+    assert(files >= 1);
+
+    assert(strcmp(nid_lib_name(db, LIB_NID), "SceTestLib") == 0);
+
+    /* Names up to the buffer limit come back whole. */
+    const char *got = nid_func_name(db, LIB_NID, FN_96);
+    assert(got && strcmp(got, name96) == 0);
+    got = nid_func_name(db, LIB_NID, FN_127);
+    assert(got && strcmp(got, name127) == 0);
+    got = nid_var_name(db, LIB_NID, VAR_127);
+    assert(got && strcmp(got, var127) == 0);
+
+    /* One byte over is unresolved, never a cut-off prefix. */
+    assert(nid_func_name(db, LIB_NID, FN_128) == NULL);
+
+    nid_db_free(db);
+    remove(path);
+    printf("nids: long names resolve whole or not at all\n");
+    return 0;
+}
